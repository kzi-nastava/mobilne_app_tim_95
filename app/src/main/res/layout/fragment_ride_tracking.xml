<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/ride_map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Top info card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_eta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_ride_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="On the way"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tv_eta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ETA: calculating..."
                android:layout_marginTop="6dp"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tv_addresses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pickup → Dropoff"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:alpha="0.85"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!--  DRIVER ONLY CANCEL RIDE BUTTON  -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel_ride"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/card_eta"
        app:layout_constraintEnd_toStartOf="@id/btn_start_ride"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="8dp"
        app:cornerRadius="16dp"
        style="@style/Widget.GrUber.Button.Filled.Red"
        android:text="@string/cancel_ride"
        />

    <!--  DRIVER ONLY START RIDE BUTTON  -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_start_ride"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/card_eta"
        app:layout_constraintEnd_toEndOf="parent"
        app:cornerRadius="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="8dp"
        android:text="@string/start_ride"
        />

    <!-- Report button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_report_driver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Report driver"
        android:layout_margin="16dp"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_trigger_panic"
        android:layout_width="62dp"
        android:layout_height="62dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/btn_report_driver"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        app:icon="@drawable/ic_panic_btn"
        style="?attr/materialIconButtonFilledStyle"
        app:iconGravity="textStart"
        android:backgroundTint="@color/panic_button_bg"
        android:drawableTint="@color/black"
        android:visibility="gone"
        />

</androidx.constraintlayout.widget.ConstraintLayout>
