<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragment.RideOrderDialogFragment">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/tb_ride_estimate"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:title="@string/book_a_ride"
        app:titleCentered="true"
        app:navigationIcon="@drawable/ic_previous"
        app:menu="@menu/toolbar_ride_est"
        app:navigationIconTint="?attr/colorOnSurface"
        app:itemIconTint="?attr/colorOnSurface"
        app:itemTextColor="?attr/colorOnSurface"
        app:popupTheme="@style/ThemeOverlay.Material3.Light"

        />
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tb_ride_estimate"
        app:dividerThickness="2dp"
        app:dividerColor="?attr/colorOnSurface"
        />

    <TextView
        android:id="@+id/tv_start_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/start_location"
        app:layout_constraintTop_toBottomOf="@id/tb_ride_estimate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/TextAppearance.GrUber.BodyMedium"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:layout_marginVertical="10dp"
        />
    
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_start_street"
        style="@style/Widget.GrUber.TextInput.Default"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_start_location"
        app:layout_constraintEnd_toStartOf="@id/til_set_street_number"
        app:layout_constraintStart_toStartOf="parent"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_start_street"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/street"
            android:inputType="textEmailAddress" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_set_street_number"
        style="@style/Widget.GrUber.TextInput.Default"
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="50dp"
        android:hint="@string/number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/til_start_street"
        app:layout_constraintTop_toBottomOf="@id/tv_start_location">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_set_street_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_set_city"
        style="@style/Widget.GrUber.TextInput.Default"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_start_street">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_set_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/city"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/til_set_city"
        app:dividerThickness="1dp"
        android:layout_marginTop="10dp"
        />

    <TextView
        android:id="@+id/tv_end_location"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/end_location"
        app:layout_constraintTop_toBottomOf="@id/til_set_city"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        style="@style/TextAppearance.GrUber.BodyMedium"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="10dp"
        />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_destination_street"
        style="@style/Widget.GrUber.TextInput.Default"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="50dp"
        android:layout_marginEnd="10dp"
        app:layout_constraintTop_toBottomOf="@id/tv_end_location"
        app:layout_constraintEnd_toStartOf="@id/til_set_street_number"
        app:layout_constraintStart_toStartOf="parent"
        >

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_set_street"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/street"
            android:inputType="textEmailAddress" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_destination_street_number"
        style="@style/Widget.GrUber.TextInput.Default"
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="50dp"
        android:hint="@string/number"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/til_destination_street"
        app:layout_constraintTop_toBottomOf="@id/tv_end_location">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_destination_street_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_destination_city"
        style="@style/Widget.GrUber.TextInput.Default"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/til_destination_street">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_destination_city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/city"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

</androidx.constraintlayout.widget.ConstraintLayout>