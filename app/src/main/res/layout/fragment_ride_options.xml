<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- INTERMEDIATE STOPS SECTION -->
        <TextView
            android:id="@+id/tv_intermediate_stops_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/intermediate_stops"
            style="@style/TextAppearance.GrUber.BodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_intermediate_stops"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tv_intermediate_stops_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btn_add_stop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_stop"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/rv_intermediate_stops"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- LINKED PASSENGERS SECTION -->
        <TextView
            android:id="@+id/tv_linked_passengers_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/linked_passengers"
            style="@style/TextAppearance.GrUber.BodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/btn_add_stop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_linked_passengers"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false"
            app:layout_constraintTop_toBottomOf="@id/tv_linked_passengers_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_passenger_email"
            style="@style/Widget.GrUber.TextInput.AutoComplete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/passenger_email"
            app:layout_constraintTop_toBottomOf="@id/rv_linked_passengers"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_add_passenger"
            android:layout_marginEnd="8dp">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/et_passenger_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_add_passenger"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/add_passenger"
            app:layout_constraintTop_toBottomOf="@id/rv_linked_passengers"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- VEHICLE OPTIONS SECTION -->
        <TextView
            android:id="@+id/tv_vehicle_type_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vehicle_type"
            style="@style/TextAppearance.GrUber.BodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/til_passenger_email"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <RadioGroup
            android:id="@+id/rg_vehicle_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tv_vehicle_type_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton
                android:id="@+id/rb_standard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/standard"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_van"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/van" />

            <RadioButton
                android:id="@+id/rb_luxury"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/luxury" />
        </RadioGroup>

        <!-- ADDITIONAL OPTIONS -->
        <CheckBox
            android:id="@+id/cb_babies"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/with_babies"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/rg_vehicle_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <CheckBox
            android:id="@+id/cb_pets"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/with_pets"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/cb_babies"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- CONFIRM BUTTON -->
        <Button
            android:id="@+id/btn_confirm_ride"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/confirm_ride"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            app:layout_constraintTop_toBottomOf="@id/cb_pets"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>
