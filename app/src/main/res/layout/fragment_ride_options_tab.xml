<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/tv_vehicle_type_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/vehicle_type"
            style="@style/TextAppearance.GrUber.BodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <RadioGroup
            android:id="@+id/rg_vehicle_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/tv_vehicle_type_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RadioButton
                android:id="@+id/rb_standard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/standard"
                android:checked="true"
                android:padding="12dp" />

            <RadioButton
                android:id="@+id/rb_van"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/van"
                android:padding="12dp" />

            <RadioButton
                android:id="@+id/rb_luxury"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/luxury"
                android:padding="12dp" />
        </RadioGroup>

        <TextView
            android:id="@+id/tv_options_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/additional_options"
            style="@style/TextAppearance.GrUber.BodyMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/rg_vehicle_type"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <CheckBox
            android:id="@+id/cb_babies"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/with_babies"
            android:layout_marginTop="12dp"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/tv_options_title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <CheckBox
            android:id="@+id/cb_pets"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/with_pets"
            android:padding="12dp"
            app:layout_constraintTop_toBottomOf="@id/cb_babies"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
