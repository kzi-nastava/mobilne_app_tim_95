<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBookRide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Book a ride"
        android:layout_margin="16dp"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/button_primary_tint"
        android:textColor="@color/button_text_color"
        app:layout_constraintTop_toBottomOf="@id/card_eta"
        app:layout_constraintEnd_toEndOf="parent"
    />
<!--        android:visibility="gone"-->

    <!-- Top info card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_eta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_ride_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ride_estimate"
                android:textStyle="bold"
                android:textSize="16sp"/>

            <TextView
                android:id="@+id/tv_eta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ETA: calculating..."
                android:layout_marginTop="6dp"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tv_addresses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Pickup → Dropoff"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:alpha="0.85"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartRide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/start_ride"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/button_primary_tint"
        android:textColor="@color/button_text_color"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancelRide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cancel_ride"
        app:cornerRadius="12dp"
        style="@style/Widget.GrUber.Button.Filled.Red"
        android:textColor="@color/button_text_color"
        app:layout_constraintTop_toBottomOf="@id/btnStartRide"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAdminLogOut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/log_out"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/button_primary_tint"
        android:textColor="@color/button_text_color"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        android:visibility="gone"
        />
    <FrameLayout
        android:id="@+id/fab_support_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_support"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="3dp"
            app:elevation="0dp"
            android:outlineProvider="none"
            android:contentDescription="Live support"
            app:srcCompat="@drawable/messages_question"
            app:backgroundTint="@color/color_primary_variant"
            app:tint="@color/white"/>

        <View
            android:id="@+id/v_support_unread_dot"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="top|end"
            android:translationZ="16dp"
            android:background="@drawable/bg_red_dot"
            android:visibility="gone"/>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
