<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/homeMapFragment">

    <fragment
        android:id="@+id/homeMapFragment"
        android:name="com.example.gruber.fragment.HomeMapFragment"
        android:label="Home">
        <action
            android:id="@+id/action_temp"
            app:destination="@id/rideTrackingFragment"/>
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.gruber.fragment.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profileFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.gruber.fragment.SettingsFragment"
        android:label="Settings">
        <action
            android:id="@+id/action_settingsFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_changePasswordFragment"
            app:destination="@id/changePasswordFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
    </fragment>

    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.gruber.fragment.EditProfileFragment"
        android:label="Profile Edit">
        <action
            android:id="@+id/action_editProfileFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.example.gruber.fragment.ChangePasswordFragment"
        android:label="Password Change">
        <action
            android:id="@+id/action_changePasswordFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/ridesHistory"
        android:name="com.example.gruber.fragment.DriversRidesFragment"
        android:label="Ride history">
        <action
            android:id="@+id/action_ridesHistory_to_rideDetailsFragment"
            app:destination="@id/rideDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/rideDetailsFragment"
        android:name="com.example.gruber.fragment.RideDetailsFragment"
        android:label="Ride details">
        <argument
            android:name="rideId"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/rideTrackingFragment"
        android:name="com.example.gruber.fragment.RideTrackingFragment"
        android:label="Ride tracking">
        <argument
            android:name="rideId"
            app:argType="string" />
    </fragment>

</navigation>
