<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    app:startDestination="@id/homeMapFragment">

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.gruber.fragment.profile.SettingsFragment"
        android:label="Settings">
        <action
            android:id="@+id/action_settingsFragment_to_editProfileFragment"
            app:destination="@id/editProfileFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_changePasswordFragment"
            app:destination="@id/changePasswordFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_profileFragment"
            app:destination="@id/profileFragment" />
        <action
            android:id="@+id/action_settingsFragment_to_homeMapFragment"
            app:destination="@id/homeMapFragment"
            app:popUpTo="@id/settingsFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <action
        android:id="@+id/action_profileFragment_to_settingsFragment"
        app:destination="@id/settingsFragment" />
    <action
        android:id="@+id/action_settingsFragment_to_editProfileFragment"
        app:destination="@id/editProfileFragment" />
    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="com.example.gruber.fragment.profile.ChangePasswordFragment"
        android:label="Password Change">
        <action
            android:id="@+id/action_changePasswordFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>
    <fragment
        android:id="@+id/editProfileFragment"
        android:name="com.example.gruber.fragment.profile.EditProfileFragment"
        android:label="Profile Edit">
        <action
            android:id="@+id/action_editProfileFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>
    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.gruber.fragment.profile.ProfileFragment"
        android:label="Profile">
        <action
            android:id="@+id/action_profileFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>
    <action
        android:id="@+id/action_settingsFragment_to_changePasswordFragment"
        app:destination="@id/changePasswordFragment" />
    <action
        android:id="@+id/action_editProfileFragment_to_settingsFragment"
        app:destination="@id/settingsFragment" />
    <fragment
        android:id="@+id/homeMapFragment"
        android:name="com.example.gruber.fragment.HomeMapFragment"
        android:label="Home" />

<!--    <fragment-->
<!--        android:id="@+id/adminActiveRidesFragment"-->
<!--        android:name="com.example.gruber.fragment.admin.AdminActiveRidesFragment"-->
<!--        android:label="Active rides" />-->

    <fragment
        android:id="@+id/adminSupportThreadsFragment"
        android:name="com.example.gruber.fragment.AdminSupportThreadsFragment"
        android:label="Support Chats">
        <action
            android:id="@+id/action_adminSupportThreadsFragment_to_adminSupportChatFragment"
            app:destination="@id/adminSupportChatFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminSupportChatFragment"
        android:name="com.example.gruber.fragment.AdminSupportChatFragment"
        android:label="Support Chat">
        <argument
            android:name="userUid"
            app:argType="string" />
        <argument
            android:name="userEmail"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/adminVehiclePricingFragment"
        android:name="com.example.gruber.fragment.VehiclePricingFragment"
        android:label="Vehicle Pricing">
        <action
            android:id="@+id/action_adminVehiclePricingFragment_to_adminReportsFragment"
            app:destination="@id/adminReportsFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminUserBlockManagementFragment"
        android:name="com.example.gruber.fragment.admin.AdminUserBlockManagementFragment"
        android:label="User Management">
        <action
            android:id="@+id/action_adminUserBlockManagementFragment_to_adminDriverRegisterAccountFragment"
            app:destination="@id/adminDriverRegisterAccountFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminDriverRegisterAccountFragment"
        android:name="com.example.gruber.fragment.admin.AdminDriverRegisterAccountFragment"
        android:label="Register Driver - Account">
        <action
            android:id="@+id/action_adminDriverRegisterAccountFragment_to_adminDriverRegisterNameFragment"
            app:destination="@id/adminDriverRegisterNameFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminDriverRegisterNameFragment"
        android:name="com.example.gruber.fragment.admin.AdminDriverRegisterNameFragment"
        android:label="Register Driver - Personal Info">
        <action
            android:id="@+id/action_adminDriverRegisterNameFragment_to_adminDriverRegisterAddressFragment"
            app:destination="@id/adminDriverRegisterAddressFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminDriverRegisterAddressFragment"
        android:name="com.example.gruber.fragment.admin.AdminDriverRegisterAddressFragment"
        android:label="Register Driver - Address">
        <action
            android:id="@+id/action_adminDriverRegisterAddressFragment_to_adminDriverRegisterVehicleFragment"
            app:destination="@id/adminDriverRegisterVehicleFragment" />
    </fragment>

    <fragment
        android:id="@+id/adminDriverRegisterVehicleFragment"
        android:name="com.example.gruber.fragment.admin.AdminDriverRegisterVehicleFragment"
        android:label="Register Driver - Vehicle Info">
        <action
            android:id="@+id/action_adminDriverRegisterVehicleFragment_to_adminUserBlockManagementFragment"
            app:destination="@id/adminUserBlockManagementFragment"
            app:popUpTo="@id/adminUserBlockManagementFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/adminReportsFragment"
        android:name="com.example.gruber.fragment.AdminReportsFragment"
        android:label="Admin Reports" />

<!--    <fragment-->
<!--        android:id="@+id/adminUsersFragment"-->
<!--        android:name="com.example.gruber.fragment.admin.AdminUsersFragment"-->
<!--        android:label="Users and drivers" />-->

</navigation>
